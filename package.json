{
  "name": "reminder",
  "version": "0.0.1",
  "description": "A Discord Reminder Bot",
  "homepage": "https://github.com/kelsin/reminder#readme",
  "repository": "github:kelsin/reminder",
  "author": "Christopher Giroir <kelsin@valefor.com>",
  "main": "src/server.js",
  "type": "module",
  "keywords": [],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "migrations:create": "wrangler d1 migrations create reminders",
    "migrations:list": "wrangler d1 migrations list reminders",
    "migrations:apply": "wrangler d1 migrations apply reminders",
    "ngrok": "ngrok http 8787",
    "pretty": "prettier -c .",
    "pretty:fix": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@(/.*)$",
      "^#(.*)$",
      "^[.]",
      "",
      "^@tests(/.*)$"
    ],
    "importOrderCaseSensitive": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "ngrok": "5.0.0-beta.2",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "dayjs": "^1.11.23",
    "discord-interactions": "^4.4.0",
    "itty-router": "^5.0.24"
  }
}
